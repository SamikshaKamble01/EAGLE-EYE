# Copy this file to .env and edit.
SECRET_KEY=change-me
FLASK_DEBUG=1
PORT=5000
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Where uploads, reports and the SQLite DB are stored
# STORAGE_DIR=storage

# ---- Vision ----
# Path to your trained YOLO model. Empty = OpenCV fallback detector.
YOLO_MODEL_PATH=
VISION_CONF_THRESHOLD=0.40
# Big photos are cut into overlapping tiles for YOLO
YOLO_TILE_SIZE=1280
YOLO_TILE_OVERLAP=0.2
YOLO_IMGSZ=1024
# Optional: map your model's class names to component types
# YOLO_CLASS_MAP=mcb=circuit_breaker,km=contactor

# ---- OCR ----
OCR_ENGINE=auto
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_MIN_CONFIDENCE=40

# ---- Rules ----
CHECK_WIRE_LABELS=true
REPORT_UNEXPECTED_LABELS=true
