# Copy this file to .env and edit.
SECRET_KEY=change-me
FLASK_DEBUG=1
PORT=5000
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Where uploads, reports and the SQLite DB are stored
# STORAGE_DIR=storage

# ---- Vision ----
# Path to your trained YOLO model. Empty = OpenCV fallback detector.
YOLO_MODEL_PATH=
VISION_CONF_THRESHOLD=0.40

# ---- OCR ----
OCR_ENGINE=auto
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_MIN_CONFIDENCE=40

# ---- Rules ----
CHECK_WIRE_LABELS=true
REPORT_UNEXPECTED_LABELS=true
